# Finalized evidence authority (required) — public RPC fallback when Helius is at 0 credits.
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
# Optional ordered failover endpoints; no implicit public RPC is added.
SOLANA_RPC_HTTP_FALLBACKS=https://solana-rpc.publicnode.com
SOLANA_RPC_WEBSOCKET=wss://api.mainnet-beta.solana.com

# WS-first cost controls: HTTP polling disabled, WS subscription only.
RUGBOT_TRACKED_POLL_DISABLED=1
RUGBOT_BLOCKHASH_POLL_ENABLED=0
RUGBOT_DISCOVER_TRADE_POLL_ENABLED=0

# Indexed nomination/enrichment only; finalized RPC confirms every candidate.
SOLSCAN_API_KEY=
GMGN_API_KEY=
# Optional PumpPortal data-feed key (creation stream is free of charge).
PUMPPORTAL_API_KEY=

SOLANA_PRIVATE_KEY=

# Polling cost controls — overrides (optional):
# RUGBOT_TRACKED_POLL_SECONDS=60
# RUGBOT_DISCOVER_TRADE_POLL_SECONDS=30
# RUGBOT_BLOCKHASH_POLL_SECONDS=30
