# Finalized evidence authority (required). Precedence is explicit: a per-call
# --rpc flag beats this file, and this file beats an inherited process env.
# No implicit public RPC is ever appended, so an unconfigured run fails closed.
SOLANA_RPC_HTTP=https://api.mainnet-beta.solana.com
# Optional ordered failover endpoints, tried after the primary and put into
# cooldown by the shared pool when they answer 429/5xx.
SOLANA_RPC_HTTP_FALLBACKS=https://solana-rpc.publicnode.com
SOLANA_RPC_WEBSOCKET=wss://api.mainnet-beta.solana.com

# WS-first cost controls: HTTP polling disabled, WS subscription only.
RUGBOT_TRACKED_POLL_DISABLED=1
RUGBOT_BLOCKHASH_POLL_ENABLED=0
# Discover trade polling is ON by default so `collect` gathers ATH/dev-dump
# evidence for the rugger ranking. This costs ~2 extra RPC req per active mint
# per poll interval (Helius credits). Set to 0/false/no/off to disable.
RUGBOT_DISCOVER_TRADE_POLL_ENABLED=1

# Indexed nomination/enrichment only; finalized RPC confirms every candidate.
SOLSCAN_API_KEY=
GMGN_API_KEY=
# Optional PumpPortal data-feed key (creation stream is free of charge).
PUMPPORTAL_API_KEY=

SOLANA_PRIVATE_KEY=

# Polling cost controls — overrides (optional):
# RUGBOT_TRACKED_POLL_SECONDS=60
# RUGBOT_DISCOVER_TRADE_POLL_SECONDS=30
# RUGBOT_BLOCKHASH_POLL_SECONDS=30
